    "@sentry/node": "11.12.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@karen/eslint-config": "workspace:*",
    "@karen/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
