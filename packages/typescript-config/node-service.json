{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "types": ["node"],
    "declaration": false,
    "declarationMap": false
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/dist"]
}
