# apps/provider-worker — copy to .env for local development.
APP_ENV=local
LOG_LEVEL=info
PROVIDER_WORKER_PORT=4200
REDIS_URL=redis://localhost:6390/2
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_ENABLED=false
TEMPORAL_API_KEY=
# TEST/LOCAL-ONLY secret for the SANDBOX mock provider. Never reuse for a real provider.
MOCK_PROVIDER_WEBHOOK_SECRET=whsec_test_only_mock_provider_0123456789
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
