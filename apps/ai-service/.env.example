# KAREN AI service — safe local defaults (mock gateway, no secrets).
# Copy to .env for local overrides. Never commit real values.

# local | test | dev | staging | production
APP_ENV=local
AI_SERVICE_PORT=8100
LOG_LEVEL=INFO

# --- OpenRouter (live gateway, ADR-0025) ------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Backend-only secret: ai-service is the only process that may read it. Put the real value in your
# untracked .env (gitignored) or Secrets Manager — never here, never in NEXT_PUBLIC_*/EXPO_PUBLIC_*.
OPENROUTER_API_KEY=
# Provider routing policy sent with every request (architecture §9):
# deny = only providers that do not store/train on prompts (production refuses "allow").
OPENROUTER_DATA_COLLECTION=deny
# true = only zero-data-retention endpoints.
OPENROUTER_ZDR=true
# mock (default; tests and local dev, no network) | live (needs key + verified registry entries)
KAREN_AI_GATEWAY_MODE=mock

# --- Task-based model routing (ADR-0026) --------------------------------------------
# Leave these EMPTY for automatic selection: per task, the router picks the least expensive
# registry model that meets the task profile (capabilities, quality floor, latency, budget).
# Set one only to PIN a model (operator override, e.g. incident response): copy the slug from
# the "Suggested env: ..." note in config/model-registry.live.json. Live mode only uses entries
# with verified_at set by `uv run karen-ai-probe --confirm-paid-calls` (docs/gateway/openrouter.md).
#   extraction / classification / short rewrites  -> ECONOMY
#   general chat                                   -> BALANCED
#   reasoning (complex planning, comparison)       -> REASONING
#   coding                                         -> CODING (REASONING tier; empty = REASONING model)
#   document analysis / summaries                  -> DOCUMENT_ANALYSIS (BALANCED tier; empty = BALANCED model)
#   vision                                         -> VISION (needs KAREN_FEATURE_VISION_ENABLED)
KAREN_MODEL_ECONOMY=
KAREN_MODEL_ECONOMY_FALLBACK=
KAREN_MODEL_BALANCED=
KAREN_MODEL_BALANCED_FALLBACK=
KAREN_MODEL_REASONING=
KAREN_MODEL_REASONING_FALLBACK=
KAREN_MODEL_CODING=
KAREN_MODEL_DOCUMENT_ANALYSIS=
KAREN_MODEL_VISION=
KAREN_MODEL_EMBEDDING=
KAREN_MODEL_RERANKING=
KAREN_MODEL_AUDIO=
# Empty = bundled config/model-registry.mock.json (mock mode only).
# Live mode: config/model-registry.live.json
KAREN_MODEL_REGISTRY_PATH=

# --- Spend and safety rails (examples, not production-sized) -----------------------
KAREN_AI_MAX_OUTPUT_TOKENS=1500
KAREN_AI_REQUEST_TIMEOUT_SECONDS=20
KAREN_AI_MAX_RETRIES=2
KAREN_AI_MAX_REQUEST_COST_USD=0.10
KAREN_AI_DAILY_BUDGET_USD=100
# memory (per-process; local/test only) | redis (shared + atomic; required when deployed)
KAREN_AI_BUDGET_STORE=memory
# Shared coordination store (budget + internal-auth replay cache). Local docker-compose Redis:
REDIS_URL=redis://localhost:6390/2
# true is refused at startup
KAREN_AI_ALLOW_DIRECT_PROVIDER_FALLBACK=false

# --- Feature-gated tiers -----------------------------------------------------------
# true serves IMAGE_UNDERSTANDING / image inputs on the VISION tier
KAREN_FEATURE_VISION_ENABLED=false
KAREN_FEATURE_EMBEDDING_ENABLED=false
KAREN_FEATURE_RERANKING_ENABLED=false
KAREN_FEATURE_AUDIO_ENABLED=false

# --- Internal auth / privacy -------------------------------------------------------
# Required (>=32 chars) in dev/staging/production. Unset in local/test disables checks.
INTERNAL_SERVICE_HMAC_SECRET=
# Only during key rotation: the old key, still accepted while callers switch over.
INTERNAL_SERVICE_HMAC_SECRET_PREVIOUS=
LOG_PSEUDONYMIZATION_KEY=

# --- Observability (all optional; missing values never fail startup) ---------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=karen-ai-service
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
