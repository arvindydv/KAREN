# KAREN AI service — safe local defaults (mock gateway, no secrets).
# Copy to .env for local overrides. Never commit real values.

# local | test | dev | staging | production
APP_ENV=local
AI_SERVICE_PORT=8100
LOG_LEVEL=INFO

# --- OpenRouter (live gateway, ADR-0025) ------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Backend-only secret: ai-service is the only process that may read it. Put the real value in your
# untracked .env (gitignored) or Secrets Manager — never here, never in NEXT_PUBLIC_*/EXPO_PUBLIC_*.
OPENROUTER_API_KEY=
# Provider routing policy sent with every request (architecture §9):
# deny = only providers that do not store/train on prompts (production refuses "allow").
OPENROUTER_DATA_COLLECTION=deny
# true = only zero-data-retention endpoints.
OPENROUTER_ZDR=true
# mock (default; tests and local dev, no network) | live (needs key + verified registry entries)
KAREN_AI_GATEWAY_MODE=mock

# --- Task-based model routing (ADR-0026) --------------------------------------------
# Leave these EMPTY for automatic selection: per task, the router picks the least expensive
# registry model that meets the task profile (capabilities, quality floor, latency, budget).
# Set one only to PIN a model (operator override, e.g. incident response): copy the slug from
# the "Suggested env: ..." note in config/model-registry.live.json. Live mode only uses entries
# with verified_at set by `uv run karen-ai-probe --confirm-paid-calls` (docs/gateway/openrouter.md).
#   extraction / classification / short rewrites  -> ECONOMY
#   general chat                                   -> BALANCED
#   reasoning (complex planning, comparison)       -> REASONING
#   coding                                         -> CODING (REASONING tier; empty = REASONING model)
#   document analysis / summaries                  -> DOCUMENT_ANALYSIS (BALANCED tier; empty = BALANCED model)
#   vision                                         -> VISION (needs KAREN_FEATURE_VISION_ENABLED)
KAREN_MODEL_ECONOMY=
KAREN_MODEL_ECONOMY_FALLBACK=
KAREN_MODEL_BALANCED=
KAREN_MODEL_BALANCED_FALLBACK=
KAREN_MODEL_REASONING=
KAREN_MODEL_REASONING_FALLBACK=
KAREN_MODEL_CODING=
KAREN_MODEL_DOCUMENT_ANALYSIS=
# Spoken turns (reply_style=spoken, ADR-0031): a low-latency model pin; its fallback is the
# normal BALANCED selection. Empty = spoken turns use the BALANCED selection too.
KAREN_MODEL_VOICE=
# (verified choice 2026-11-22: meta-llama/llama-4-maverick — see ADR-0032)
KAREN_MODEL_VISION=
KAREN_MODEL_EMBEDDING=
KAREN_MODEL_RERANKING=
KAREN_MODEL_AUDIO=
# Empty = bundled config/model-registry.mock.json (mock mode only).
# Live mode: config/model-registry.live.json
KAREN_MODEL_REGISTRY_PATH=

# --- Spend and safety rails (examples, not production-sized) -----------------------
KAREN_AI_MAX_OUTPUT_TOKENS=1500
KAREN_AI_REQUEST_TIMEOUT_SECONDS=20
KAREN_AI_MAX_RETRIES=2
KAREN_AI_MAX_REQUEST_COST_USD=0.10
KAREN_AI_DAILY_BUDGET_USD=100
# memory (per-process; local/test only) | redis (shared + atomic; required when deployed)
KAREN_AI_BUDGET_STORE=memory
# Shared coordination store (budget + internal-auth replay cache). Local docker-compose Redis:
REDIS_URL=redis://localhost:6390/2
# true is refused at startup
KAREN_AI_ALLOW_DIRECT_PROVIDER_FALLBACK=false

# --- Feature-gated tiers -----------------------------------------------------------
# true serves IMAGE_UNDERSTANDING / image inputs on the VISION tier
KAREN_FEATURE_VISION_ENABLED=false
KAREN_FEATURE_EMBEDDING_ENABLED=false
KAREN_FEATURE_RERANKING_ENABLED=false
KAREN_FEATURE_AUDIO_ENABLED=false

# --- Voice: speech-to-text + text-to-speech (ADR-0026) -----------------------------
# Off by default. In mock mode, true enables labelled mock transcripts and silent mock audio.
KAREN_FEATURE_VOICE_ENABLED=false
# Empty = bundled config/voice-catalog.mock.json. Live: config/voice-catalog.live.json
# (generated by `uv run karen-ai-voice-catalog`, free; entries must be verified before live use).
KAREN_VOICE_CATALOG_PATH=
# Per-request reservations (speech billing units are not documented upstream; operator-set).
KAREN_VOICE_STT_RESERVE_USD=0.01
KAREN_VOICE_TTS_RESERVE_USD=0.02
KAREN_VOICE_MAX_SPEECH_CHARS=2000
KAREN_VOICE_TIMEOUT_SECONDS=30
# Speech providers, chosen independently (ADR-0027): mock | openrouter | deepgram.
# Empty = mock in mock gateway mode, openrouter in live mode. Any non-mock provider makes PAID calls
# and needs a catalog whose entries carry verified_at (set by karen-ai-speech-probe, see
# docs/voice/deepgram.md). With deepgram: KAREN_VOICE_CATALOG_PATH=config/voice-catalog.deepgram.json
KAREN_VOICE_STT_PROVIDER=
KAREN_VOICE_TTS_PROVIDER=
# Live (hands-free) conversations: streamed audio, live transcripts, turn detection, barge-in.
KAREN_FEATURE_VOICE_LIVE_ENABLED=false
# A live session ends after this much audio, or after this long without audio.
KAREN_VOICE_LIVE_MAX_SECONDS=300
KAREN_VOICE_LIVE_IDLE_SECONDS=20

# --- Deepgram (speech provider, ADR-0027) ------------------------------------------
# Backend-only secret: only ai-service reads it. Put the real value in your untracked .env (or
# Secrets Manager) — never here, never in NEXT_PUBLIC_*/EXPO_PUBLIC_*. Clients never receive it
# (not even short-lived Deepgram tokens: audio is proxied through the API and ai-service).
DEEPGRAM_API_KEY=
# global (api.deepgram.com) | in (api.in.deepgram.com: processed and kept in India) | eu | au
# Recommended for India users: `in` — measured 2026-11-22, voice first audio 0.81 s vs 1.23 s (ADR-0032).
DEEPGRAM_REGION=global
# true = opt out of Deepgram's Model Improvement Program (audio not used for training).
DEEPGRAM_MIP_OPT_OUT=true
# Optional pins (catalog IDs). Empty = first verified catalog entry for each use.
#   batch voice messages -> DEEPGRAM_STT_MODEL      (catalog: deepgram/nova-3)
#   live conversations   -> DEEPGRAM_STT_LIVE_MODEL (catalog: deepgram/flux-general-multi)
#   spoken replies       -> DEEPGRAM_TTS_MODEL      (catalog: deepgram/flux-tts or deepgram/aura-2)
DEEPGRAM_STT_MODEL=
DEEPGRAM_STT_LIVE_MODEL=
DEEPGRAM_TTS_MODEL=
# Flux end-of-turn detection (ADR-0033): confidence threshold 0.5-0.9; max silence (ms).
# 0.5/1000 split sentences at thinking pauses; 0.7/2000 felt slow. 0.6/1500 is the middle (not measured).
DEEPGRAM_EOT_THRESHOLD=0.6
DEEPGRAM_EOT_TIMEOUT_MS=1500

# --- Internal auth / privacy -------------------------------------------------------
# Required (>=32 chars) in dev/staging/production. Unset in local/test disables checks.
INTERNAL_SERVICE_HMAC_SECRET=
# Only during key rotation: the old key, still accepted while callers switch over.
INTERNAL_SERVICE_HMAC_SECRET_PREVIOUS=
LOG_PSEUDONYMIZATION_KEY=

# --- Observability (all optional; missing values never fail startup) ---------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=karen-ai-service
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
