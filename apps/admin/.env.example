# apps/admin — SERVER-SIDE values (never NEXT_PUBLIC_*). The browser talks only to this app;
# the app's route handlers and server components call the API.

# local | test | dev | staging | production. Default: production for `next build`/`next start`,
# local for `next dev`. With local/test under `next dev`, cookies are `karen_staff` /
# `karen_staff_csrf` without Secure (plain-http localhost); otherwise `__Host-` + Secure.
APP_ENV=local
# Where the API is reachable from the admin server (internal network in deployed envs).
API_INTERNAL_BASE_URL=http://localhost:4100
# Exact public origin of the admin console. REQUIRED outside local/test — without it every
# browser→BFF request is refused (Origin check fails closed).
# ADMIN_APP_ORIGIN=https://admin.example.com
# Shared with the API; signs the forwarded end-user IP (x-karen-client-ip). >=32 chars.
# REQUIRED outside local/test. Must equal the API value. Never NEXT_PUBLIC_.
# INTERNAL_SERVICE_HMAC_SECRET=
# Number of trusted proxy hops in front of this app (ALB = 1).
# BFF_TRUSTED_PROXY_HOPS=1
