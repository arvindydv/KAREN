{
  "name": "@karen/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "prisma generate && nest start --watch --preserveWatchOutput --exec \"node --env-file-if-exists=.env --enable-source-maps\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:roles": "node scripts/db-roles.mjs",
    "db:seed": "prisma generate && pnpm build && node --env-file-if-exists=.env dist/seed/seed.js",
    "db:reset": "prisma migrate reset",
    "openapi:generate": "prisma generate && pnpm build && node --env-file-if-exists=.env dist/openapi/emit.js ../../packages/api-contracts/openapi/karen-api.v1.json && pnpm --filter @karen/api-contracts generate:types",
    "mail:smoke": "node --env-file-if-exists=.env scripts/mail-smoke.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.10",
    "@karen/ai-model-contracts": "workspace:*",
    "@karen/api-contracts": "workspace:*",
    "@karen/config": "workspace:*",
    "@karen/domain": "workspace:*",
    "@karen/observability": "workspace:*",
    "@karen/types": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@temporalio/client": "1.25.0",
    "fastify": "5.12.8",
    "ioredis": "5.11.1",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@karen/eslint-config": "workspace:*",
    "@karen/test-fixtures": "workspace:*",
    "@karen/typescript-config": "workspace:*",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
