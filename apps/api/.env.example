# apps/api — copy to .env for local development (`pnpm setup:env` does this for you).
# Canonical reference: docs/development/environment-variables.md
APP_ENV=local
LOG_LEVEL=info
API_PORT=4100
API_PUBLIC_BASE_URL=http://localhost:4100
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
API_BODY_LIMIT_BYTES=1048576
API_RATE_LIMIT_PER_MINUTE=120
# Strict limit for auth/OTP/approval routes; fails closed (503) when Redis is unavailable.
API_SENSITIVE_RATE_LIMIT_PER_MINUTE=10
# Reverse proxies whose X-Forwarded-For entries are trusted (ALB=1, Cloudflare+ALB=2).
API_TRUSTED_PROXY_HOPS=1
API_DOCS_ENABLED=true

# Runtime role: least privilege, subject to row-level security (create it with `pnpm db:roles`).
DATABASE_URL=postgresql://karen_api_local:karen_api_local_only@localhost:5442/karen
# Migration/owner role: used only by the Prisma CLI (migrate, diff, seed) and `pnpm db:roles`.
MIGRATION_DATABASE_URL=postgresql://karen:karen_local_only@localhost:5442/karen
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6390/0
# Disposable database for `pnpm db:migrate:diff` drift checks only.
SHADOW_DATABASE_URL=postgresql://karen:karen_local_only@localhost:5442/karen_shadow

# Auth. local-dev mode issues signed tokens from POST /dev/auth/token and is REFUSED outside APP_ENV=local|test.
AUTH_MODE=local-dev
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
# Amazon Cognito access tokens (ADR-0015): OIDC_AUDIENCE=<app client id>, OIDC_AUDIENCE_CLAIM=client_id, OIDC_REQUIRED_TOKEN_USE=access
OIDC_AUDIENCE_CLAIM=aud
OIDC_REQUIRED_TOKEN_USE=

AI_SERVICE_URL=http://localhost:8100
# Leave empty locally (ai-service also has it empty). REQUIRED in dev/staging/production.
INTERNAL_SERVICE_HMAC_SECRET=

KAREN_EXECUTION_PAUSED=false

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_PSEUDONYMIZATION_KEY=local-only-pseudonymization-key-not-secret
