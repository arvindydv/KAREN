# apps/api — copy to .env for local development (`pnpm setup:env` does this for you).
# Canonical reference: docs/development/environment-variables.md
APP_ENV=local
LOG_LEVEL=info
API_PORT=4100
API_PUBLIC_BASE_URL=http://localhost:4100
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
API_BODY_LIMIT_BYTES=1048576
API_RATE_LIMIT_PER_MINUTE=120
# Strict limit for auth/OTP/approval routes; fails closed (503) when Redis is unavailable.
API_SENSITIVE_RATE_LIMIT_PER_MINUTE=10
# Reverse proxies whose X-Forwarded-For entries are trusted (ALB=1, Cloudflare+ALB=2).
API_TRUSTED_PROXY_HOPS=1
API_DOCS_ENABLED=true

# Runtime role: least privilege, subject to row-level security (create it with `pnpm db:roles`).
DATABASE_URL=postgresql://karen_api_local:karen_api_local_only@localhost:5442/karen
# Migration/owner role: used only by the Prisma CLI (migrate, diff, seed) and `pnpm db:roles`.
MIGRATION_DATABASE_URL=postgresql://karen:karen_local_only@localhost:5442/karen
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6390/0
# Disposable database for `pnpm db:migrate:diff` drift checks only.
SHADOW_DATABASE_URL=postgresql://karen:karen_local_only@localhost:5442/karen_shadow

# Auth (ADR-0015/0016). `first-party` is the only deployed mode; `local-dev` additionally exposes
# POST /dev/auth/token and is REFUSED outside APP_ENV=local|test.
AUTH_MODE=local-dev
# Access-token signing keys: JSON array of EC P-256 private JWKs. Empty locally ⇒ an ephemeral key
# per process (fine for one local API). REQUIRED when deployed (Secrets Manager).
ACCESS_TOKEN_SIGNING_KEYS=
ACCESS_TOKEN_CURRENT_KID=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
WEB_SESSION_IDLE_HOURS=24
WEB_SESSION_ABSOLUTE_DAYS=30
LOGIN_MAX_FAILURES=10

# Password pepper (ADR-0015). Optional locally; REQUIRED in deployed envs (Secrets Manager).
# Format: <id>:<base64url ≥32 bytes>[,<id>:<key>...]. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASSWORD_PEPPERS=
PASSWORD_PEPPER_CURRENT_ID=
PASSWORD_HASH_MAX_CONCURRENCY=4
PASSWORD_HASH_MAX_QUEUE=64
PASSWORD_HASH_QUEUE_TIMEOUT_MS=2000

# One-time e-mail codes (ADR-0018). OTP_HMAC_KEY: ≥32 chars, REQUIRED when deployed.
OTP_HMAC_KEY=
# Transactional e-mail. `memory` (local/test only) keeps mail in-process; `brevo-smtp` sends
# via Brevo. Put Brevo credentials ONLY in your untracked .env (Secrets Manager when deployed).
EMAIL_TRANSPORT=memory
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM=
EMAIL_SEND_LIMIT_PER_HOUR=5

AI_SERVICE_URL=http://localhost:8100
# Leave empty locally (ai-service also has it empty). REQUIRED in dev/staging/production.
INTERNAL_SERVICE_HMAC_SECRET=

KAREN_EXECUTION_PAUSED=false

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_PSEUDONYMIZATION_KEY=local-only-pseudonymization-key-not-secret
