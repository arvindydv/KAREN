// KAREN business database (PostgreSQL 17 + pgvector). PostgreSQL is the authoritative source
// of business state; Redis is never authoritative (architecture §8).
//
// Schema ownership (docs/database/conventions.md):
//   identity  — users, external identity links, staff role grants      (owner: api/identity)
//   consent   — consent grants, legal acceptances                       (owner: api/consent)
//   audit     — append-only audit events (DB trigger blocks UPDATE/DELETE) (owner: api/audit)
//   platform  — transactional outbox, API idempotency records, AI usage   (owner: api/platform)
//   conversation — threads, messages, stream events, feedback (Phase 02) (owner: api/conversation)
// Future schemas (memory, tasks, approvals, conversations, providers, notifications, billing)
// are documented in docs/database/future-entities.md and arrive with their features.
//
// Conventions: UUID v4 PKs generated in the DB, snake_case tables/columns, timestamptz,
// created_at/updated_at on mutable rows, `version` for optimistic concurrency, every
// user-owned row carries user_id with an index leading on it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "consent", "audit", "platform", "staff", "conversation"]
}

/// Account lifecycle (ADR-0015). Transitions are enforced by @karen/domain
/// `ACCOUNT_TRANSITIONS` AND by the identity.enforce_user_status_transition trigger.
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DELETION_REQUESTED
  DELETED

  @@schema("identity")
}

enum StaffRole {
  support_agent
  ops_admin
  security_admin

  @@schema("identity")
}

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName   String?    @map("display_name") @db.VarChar(120)
  /// How KAREN addresses the user (M4).
  preferredName String?    @map("preferred_name") @db.VarChar(60)
  /// ISO 3166-1 alpha-2 / ISO 4217 (M4). Optional; never inferred from location.
  country       String?    @db.Char(2)
  currency      String?    @db.Char(3)
  locale        String     @default("en-IN") @db.VarChar(35)
  timezone      String     @default("Asia/Kolkata") @db.VarChar(64)
  status        UserStatus @default(PENDING_VERIFICATION)
  version       Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  externalIdentities ExternalIdentity[]
  email              UserEmail?
  passwordCredential PasswordCredential?
  challenges         VerificationChallenge[]
  devices            Device[]
  sessions           Session[]
  preferences        UserPreferences?
  onboarding         OnboardingProgress?
  places             SavedPlace[]
  staffRoles         StaffRoleGrant[]
  consentGrants      ConsentGrant[]
  consentReceipts    ConsentReceipt[]
  dataRightsRequests DataRightsRequest[]
  legalAcceptances   LegalAcceptance[]
  threads            ConversationThread[]
  aiInvocations      AiInvocation[]
  usageLedger        UsageLedgerEntry[]

  @@map("users")
  @@schema("identity")
}

/// Maps an OIDC (issuer, subject) pair to the internal user. Never keyed by e-mail.
model ExternalIdentity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  issuer     String   @db.VarChar(512)
  subject    String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("external_identities")
  @@schema("identity")
}

/// The account's e-mail address (one per account in Phase 01). `email_canonical` is the
/// case-insensitive identity key (rules: canonicalizeEmail in @karen/domain); `email` keeps the
/// user's casing for display. A pending e-mail CHANGE lives in a challenge, not here (M4).
model UserEmail {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  email          String    @db.VarChar(254)
  emailCanonical String    @unique @map("email_canonical") @db.VarChar(254)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(3)
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_emails")
  @@schema("identity")
}

/// Argon2id password verifier (ADR-0015). Never the password; never logged; never returned by
/// any API. `pepper_id` names the Secrets-Manager-held pepper used (null = none).
model PasswordCredential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  pepperId          String?  @map("pepper_id") @db.VarChar(32)
  scheme            String   @db.VarChar(32)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
  @@schema("identity")
}

enum ChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE

  @@schema("identity")
}

/// One-time e-mail code bound to an opaque handle held by the client that started the flow
/// (ADR-0015 pre-account-takeover defence). Stores only verifiers: SHA-256 of the handle and
/// an HMAC of (handle, code) under OTP_HMAC_KEY. Never the code itself.
model VerificationChallenge {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  purpose              ChallengePurpose
  handleVerifier       String           @unique @map("handle_verifier") @db.VarChar(80)
  codeMac              String           @map("code_mac") @db.VarChar(80)
  attempts             Int              @default(0)
  maxAttempts          Int              @default(5) @map("max_attempts")
  sendCount            Int              @default(1) @map("send_count")
  expiresAt            DateTime         @map("expires_at") @db.Timestamptz(3)
  /// consumed | superseded | attempts_exhausted
  closedAt             DateTime?        @map("closed_at") @db.Timestamptz(3)
  closeReason          String?          @map("close_reason") @db.VarChar(32)
  /// EMAIL_CHANGE only: the address being verified (display + canonical).
  targetEmail          String?          @map("target_email") @db.VarChar(254)
  targetEmailCanonical String?          @map("target_email_canonical") @db.VarChar(254)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_challenges")
  @@schema("identity")
}

enum ClientKind {
  WEB
  IOS
  ANDROID

  @@schema("identity")
}

/// A client installation the user signed in from (ADR-0016). `installation_id` is generated by
/// the client per install — not a hardware fingerprint. `name` is user-supplied plain text.
model Device {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  installationId String     @map("installation_id") @db.Uuid
  platform       ClientKind
  name           String?    @db.VarChar(64)
  firstSeenAt    DateTime   @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, installationId])
  @@map("devices")
  @@schema("identity")
}

/// Authoritative session record, checked on EVERY authenticated request (ADR-0016).
/// Web sessions carry an opaque token verifier; mobile sessions use refresh credentials.
model Session {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  deviceId          String     @map("device_id") @db.Uuid
  client            ClientKind
  /// sha256 of the web session token (`kss_…`); null for mobile sessions.
  tokenVerifier     String?    @unique @map("token_verifier") @db.VarChar(80)
  authMethod        String     @map("auth_method") @db.VarChar(32)
  authTime          DateTime   @default(now()) @map("auth_time") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime   @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime   @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?    @map("revoke_reason") @db.VarChar(48)

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device  Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  refresh RefreshCredential[]

  @@index([userId, revokedAt])
  @@index([deviceId])
  @@map("sessions")
  @@schema("identity")
}

/// Single-use rotating refresh token (`krt_…`), stored as a sha256 verifier. One chain per
/// session; reuse of a consumed generation revokes the session (ADR-0016).
model RefreshCredential {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  verifier    String    @unique @db.VarChar(80)
  generation  Int
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// Successor issued when this one was consumed (idempotent retry window).
  successorId String?   @map("successor_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, generation])
  @@index([userId])
  @@map("refresh_credentials")
  @@schema("identity")
}

/// User preferences (M4). Conservative defaults: optional notifications OFF.
model UserPreferences {
  userId             String   @id @map("user_id") @db.Uuid
  language           String   @default("en") @db.VarChar(16)
  script             String   @default("latin") @db.VarChar(16)
  dateFormat         String   @default("dmy") @map("date_format") @db.VarChar(8)
  timeFormat         String   @default("12h") @map("time_format") @db.VarChar(8)
  theme              String   @default("system") @db.VarChar(16)
  textSize           String   @default("default") @map("text_size") @db.VarChar(16)
  reducedMotion      Boolean  @default(false) @map("reduced_motion")
  highContrast       Boolean  @default(false) @map("high_contrast")
  notifyProductEmail Boolean  @default(false) @map("notify_product_email")
  notifyPush         Boolean  @default(false) @map("notify_push")
  quietHoursStart    String?  @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd      String?  @map("quiet_hours_end") @db.VarChar(5)
  /// Spoken-voice preferences (ADR-0026/0027); CHECK constraint user_preferences_voice_v2.
  voiceAccent        String   @default("indian") @map("voice_accent") @db.VarChar(16)
  voiceGender        String   @default("any") @map("voice_gender") @db.VarChar(8)
  voiceSpeedPct      Int      @default(100) @map("voice_speed_pct") @db.SmallInt
  voiceAutoplay      Boolean  @default(false) @map("voice_autoplay")
  voiceEnabled       Boolean  @default(true) @map("voice_enabled")
  voiceReplies       Boolean  @default(true) @map("voice_replies")
  /// auto | en | hi | hi-Latn — reply language for typed and spoken messages (ADR-0027).
  replyLanguage      String   @default("auto") @map("reply_language") @db.VarChar(8)
  voiceId            String?  @map("voice_id") @db.VarChar(128)
  version            Int      @default(0)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("identity")
}

/// Saved addresses (M4). Typed by the user; no coordinates (precise location needs consent, M6).
model SavedPlace {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kind       String   @db.VarChar(8)
  label      String   @db.VarChar(40)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String   @db.VarChar(100)
  region     String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(12)
  country    String   @db.Char(2)
  version    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_places")
  @@schema("identity")
}

/// Onboarding progress (M5). Records progress only; data lives in profile/preferences/consents.
/// `completed_steps` is a set: completing a step is an idempotent, commutative union, so retries
/// and concurrent progress from several devices converge.
model OnboardingProgress {
  userId         String    @id @map("user_id") @db.Uuid
  status         String    @default("in_progress") @db.VarChar(16)
  completedSteps String[]  @default([]) @map("completed_steps") @db.VarChar(32)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  skippedAt      DateTime? @map("skipped_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
  @@schema("identity")
}

/// Staff roles are granted server-side only; token claims never confer staff permissions.
model StaffRoleGrant {
  userId    String    @map("user_id") @db.Uuid
  role      StaffRole
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("staff_role_grants")
  @@schema("identity")
}

enum ConsentPurpose {
  AI_PROCESSING
  MEMORY_STORAGE
  CONNECTOR_ACCESS
  PROACTIVE_SUGGESTIONS
  COMMUNICATIONS
  ACTION_EXECUTION
  PRODUCT_ANALYTICS
  PERSONALIZATION
  PRECISE_LOCATION
  AUDIO_RETENTION
  FAMILY_SHARING

  @@schema("consent")
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
  DENIED

  @@schema("consent")
}

model ConsentGrant {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  purpose       ConsentPurpose
  /// Narrowing scope, e.g. "*" or a provider/capability identifier.
  scope         String         @default("*") @db.VarChar(255)
  providerId    String?        @map("provider_id") @db.VarChar(64)
  policyVersion String         @map("policy_version") @db.VarChar(32)
  status        ConsentStatus  @default(ACTIVE)
  /// sha256 of the consent receipt shown to the user (proof of what was agreed).
  receiptHash   String         @map("receipt_hash") @db.VarChar(80)
  grantedAt     DateTime       @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  version       Int            @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose, scope])
  @@index([userId, purpose, status])
  @@map("consent_grants")
  @@schema("consent")
}

model LegalAcceptance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  documentType    String   @map("document_type") @db.VarChar(64)
  documentVersion String   @map("document_version") @db.VarChar(32)
  locale          String   @db.VarChar(35)
  /// sha256 of the exact notice text accepted (M6).
  noticeSha256    String?  @map("notice_sha256") @db.VarChar(80)
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentVersion])
  @@map("legal_acceptances")
  @@schema("consent")
}

/// Versioned legal notices (M6). Approved rows are immutable (trigger); drafts are never served
/// outside local/test. Content is reviewed by legal before approval — never by code.
model Notice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String    @db.VarChar(32)
  locale        String    @db.VarChar(8)
  version       String    @db.VarChar(32)
  state         String    @default("draft") @db.VarChar(16)
  content       String
  contentSha256 String    @map("content_sha256") @db.VarChar(80)
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz(3)
  approvedBy    String?   @map("approved_by") @db.VarChar(128)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([kind, locale, version])
  @@map("notices")
  @@schema("consent")
}

/// Append-only, per-user hash-chained consent receipts (M6). receipt_hash = sha256 over the
/// canonical receipt including prev_hash; receipt_mac = HMAC(server key, receipt_hash).
model ConsentReceipt {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  seq            Int
  purpose        ConsentPurpose
  scope          String         @default("*") @db.VarChar(255)
  decision       String         @db.VarChar(16)
  noticeKind     String         @map("notice_kind") @db.VarChar(32)
  noticeVersion  String         @map("notice_version") @db.VarChar(32)
  noticeSha256   String         @map("notice_sha256") @db.VarChar(80)
  source         String         @db.VarChar(32)
  method         String         @db.VarChar(64)
  idempotencyKey String?        @map("idempotency_key") @db.VarChar(128)
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz(3)
  prevHash       String?        @map("prev_hash") @db.VarChar(80)
  receiptHash    String         @map("receipt_hash") @db.VarChar(80)
  receiptMac     String         @map("receipt_mac") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seq])
  @@unique([userId, idempotencyKey])
  @@map("consent_receipts")
  @@schema("consent")
}

/// Data export / account deletion requests (M7). Kept after erasure as proof the request was
/// honoured (retention exception). `active_kind` = kind while open, NULL when closed, so
/// UNIQUE(user_id, active_kind) allows at most one open request per kind.
model DataRightsRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  kind                String    @db.VarChar(16)
  status              String    @db.VarChar(16)
  activeKind          String?   @map("active_kind") @db.VarChar(16)
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  scheduledFor        DateTime? @map("scheduled_for") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(3)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(3)
  exportPayload       Json?     @map("export_payload")
  exportSha256        String?   @map("export_sha256") @db.VarChar(80)
  workflowId          String?   @map("workflow_id") @db.VarChar(128)
  retentionExceptions Json      @default("[]") @map("retention_exceptions")
  version             Int       @default(0)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activeKind])
  @@index([userId, requestedAt(sort: Desc)])
  @@map("data_rights_requests")
  @@schema("consent")
}

// ── Staff realm (Phase 01 M8, ADR-0017) ───────────────────────────────────────────────────
// Separate identities, credentials, sessions and roles. Reached ONLY through the staff DB role
// (karen_staff_runtime); the consumer request path's role has no privileges on this schema.

/// A staff identity. Not a consumer account; the same person may have both, unlinked.
model StaffAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @db.VarChar(254)
  emailCanonical String   @unique @map("email_canonical") @db.VarChar(254)
  displayName    String   @map("display_name") @db.VarChar(120)
  /// invited → active (after WebAuthn enrollment) → disabled
  status         String   @default("invited") @db.VarChar(16)
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  password    StaffPasswordCredential?
  webauthn    StaffWebauthnCredential[]
  sessions    StaffSession[]
  roles       StaffRoleAssignment[]
  elevations  StaffElevation[]
  enrollments StaffEnrollment[]

  @@map("accounts")
  @@schema("staff")
}

model StaffPasswordCredential {
  staffId           String   @id @map("staff_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  pepperId          String?  @map("pepper_id") @db.VarChar(32)
  scheme            String   @db.VarChar(32)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  version           Int      @default(0)

  account StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
  @@schema("staff")
}

/// WebAuthn credential (security key / passkey). Public key only; the private key never leaves
/// the authenticator. `counter` detects cloned authenticators.
model StaffWebauthnCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  credentialId String    @unique @map("credential_id") @db.VarChar(1024)
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([]) @db.VarChar(16)
  deviceType   String    @map("device_type") @db.VarChar(32)
  backedUp     Boolean   @map("backed_up")
  name         String    @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  account StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("webauthn_credentials")
  @@schema("staff")
}

model StaffSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId           String    @map("staff_id") @db.Uuid
  tokenVerifier     String    @unique @map("token_verifier") @db.VarChar(80)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  /// Last fresh WebAuthn assertion (sign-in or step-up).
  stepUpAt          DateTime  @map("step_up_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(48)

  account StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, revokedAt])
  @@map("sessions")
  @@schema("staff")
}

/// Standing (minimal) role grants. Elevated access is time-boxed via StaffElevation.
model StaffRoleAssignment {
  staffId   String   @map("staff_id") @db.Uuid
  role      String   @db.VarChar(32)
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  account StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, role])
  @@map("role_grants")
  @@schema("staff")
}

/// Just-in-time elevation: requested with a reason + ticket, approved by ANOTHER security admin,
/// expires automatically.
model StaffElevation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId         String    @map("staff_id") @db.Uuid
  role            String    @db.VarChar(32)
  reason          String    @db.VarChar(500)
  ticketRef       String    @map("ticket_ref") @db.VarChar(64)
  status          String    @default("pending") @db.VarChar(16)
  durationMinutes Int       @map("duration_minutes")
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedBy       String?   @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)

  account StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
  @@map("elevations")
  @@schema("staff")
}

/// One-time WebAuthn enrollment link (bootstrap or invitation). Token stored as a verifier.
model StaffEnrollment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  tokenVerifier String    @unique @map("token_verifier") @db.VarChar(80)
  createdBy     String?   @map("created_by") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("enrollments")
  @@schema("staff")
}

enum ActorType {
  USER
  STAFF
  SYSTEM
  SERVICE

  @@schema("audit")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@schema("audit")
}

/// Append-only. UPDATE/DELETE are rejected by a trigger (see migration). Metadata must be
/// pre-redacted by the writer; never store tokens, prompts or sensitive personal data here.
model AuditEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType      ActorType    @map("actor_type")
  /// Internal user UUID or service name. Not an e-mail.
  actorRef       String?      @map("actor_ref") @db.VarChar(128)
  action         String       @db.VarChar(128)
  subjectType    String?      @map("subject_type") @db.VarChar(64)
  subjectId      String?      @map("subject_id") @db.VarChar(128)
  outcome        AuditOutcome
  /// Which policy produced the decision and its version, e.g. "rbac:v1", "execution-policy:v1".
  policyDecision String?      @map("policy_decision") @db.VarChar(128)
  /// Machine-readable reason, e.g. "missing_permission", "consent_absent". Never free text.
  reasonCode     String?      @map("reason_code") @db.VarChar(64)
  requestId      String?      @map("request_id") @db.VarChar(128)
  traceId        String?      @map("trace_id") @db.VarChar(64)
  metadata       Json         @default("{}")

  @@index([actorRef, occurredAt(sort: Desc)])
  @@index([subjectType, subjectId, occurredAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_events")
  @@schema("audit")
}

/// Transactional outbox: written in the same transaction as the state change it describes,
/// relayed to SQS/EventBridge by a worker (architecture §8). Relay arrives with first consumer.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(128)
  eventVersion  Int       @default(1) @map("event_version")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
  @@schema("platform")
}

/// Server-side idempotency for client-retried POSTs (e.g. task creation client_request_id).
model IdempotencyRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  scope              String   @db.VarChar(64)
  key                String   @db.VarChar(128)
  requestFingerprint String   @map("request_fingerprint") @db.VarChar(80)
  responseStatus     Int?     @map("response_status")
  responseBody       Json?    @map("response_body")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("platform")
}

// ── Conversations (Phase 02, ADR-0021) ───────────────────────────────────────────────────
// Owned by apps/api conversation module. ai-service never touches these tables. RLS: owner only.

/// A conversation thread. `next_seq` allocates message positions under a row lock.
model ConversationThread {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  title         String    @db.VarChar(120)
  /// auto (derived from the first message) | user (renamed by the user; never overwritten)
  titleSource   String    @default("auto") @map("title_source") @db.VarChar(8)
  locale        String    @db.VarChar(35)
  /// standard | ephemeral (auto-deleted at expires_at)
  mode          String    @default("standard") @db.VarChar(16)
  pinned        Boolean   @default(false)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(3)
  nextSeq       Int       @default(1) @map("next_seq")
  /// Thread document schema version (data migrations of stored message formats).
  schemaVersion Int       @default(1) @map("schema_version")
  version       Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, pinned(sort: Desc), lastMessageAt(sort: Desc)])
  @@index([userId, archivedAt])
  @@map("threads")
  @@schema("conversation")
}

/// One message. Assistant messages carry generation state; content is plain text/Markdown.
model ConversationMessage {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  threadId             String    @map("thread_id") @db.Uuid
  seq                  Int
  /// user | assistant (server-assigned; clients never choose)
  role                 String    @db.VarChar(16)
  status               String    @db.VarChar(16)
  content              String    @default("")
  clientIdempotencyKey String?   @map("client_idempotency_key") @db.VarChar(128)
  /// text | voice — how a user message was entered; voice turns get spoken-style answers (ADR-0029)
  inputMode            String    @default("text") @map("input_mode") @db.VarChar(8)
  /// AI request id (assistant) — one per generation attempt; never reused.
  requestId            String?   @map("request_id") @db.VarChar(128)
  replyToMessageId     String?   @map("reply_to_message_id") @db.Uuid
  regeneratedFromId    String?   @map("regenerated_from_id") @db.Uuid
  supersededAt         DateTime? @map("superseded_at") @db.Timestamptz(3)
  errorCode            String?   @map("error_code") @db.VarChar(64)
  errorRetryable       Boolean?  @map("error_retryable")
  finishReason         String?   @map("finish_reason") @db.VarChar(32)
  routeTier            String?   @map("route_tier") @db.VarChar(16)
  isMock               Boolean?  @map("is_mock")
  lastEventSeq         Int       @default(0) @map("last_event_seq")
  /// Generation lease: a runner renews it; an expired lease means the runner died.
  leaseExpiresAt       DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  cancelRequestedAt    DateTime? @map("cancel_requested_at") @db.Timestamptz(3)
  startedAt            DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  thread   ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  events   MessageEvent[]
  feedback MessageFeedback?

  @@unique([threadId, seq])
  @@unique([userId, clientIdempotencyKey])
  @@index([userId, threadId, seq])
  @@map("messages")
  @@schema("conversation")
}

/// Persisted public stream events (resume + audit of status changes). Short retention.
model MessageEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  seq       Int
  type      String   @db.VarChar(24)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, seq])
  @@index([userId, messageId, seq])
  @@map("message_events")
  @@schema("conversation")
}

/// Thumbs up/down + category on an assistant message (one per message).
model MessageFeedback {
  messageId String   @id @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    String   @db.VarChar(8)
  category  String?  @db.VarChar(32)
  comment   String?  @db.VarChar(1000)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedback")
  @@schema("conversation")
}

/// One AI generation attempt's metadata (ADR-0023). Never prompt or completion text.
model AiInvocation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  messageId        String?  @map("message_id") @db.Uuid
  requestId        String   @unique @map("request_id") @db.VarChar(128)
  routeTier        String?  @map("route_tier") @db.VarChar(16)
  requestedModel   String?  @map("requested_model") @db.VarChar(128)
  servedModel      String?  @map("served_model") @db.VarChar(128)
  gatewayRequestId String?  @map("gateway_request_id") @db.VarChar(128)
  promptVersion    String?  @map("prompt_version") @db.VarChar(64)
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  /// USD micro-units (1e-6 USD).
  costMicroUsd     BigInt   @default(0) @map("cost_micro_usd")
  ttftMs           Int?     @map("ttft_ms")
  latencyMs        Int?     @map("latency_ms")
  fallbackUsed     Boolean  @default(false) @map("fallback_used")
  isMock           Boolean  @map("is_mock")
  /// completed | incomplete | failed | canceled
  status           String   @db.VarChar(16)
  errorCode        String?  @map("error_code") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_invocations")
  @@schema("platform")
}

/// Authoritative per-user daily AI usage (ADR-0023). Redis holds the fast counters.
model UsageLedgerEntry {
  userId       String   @map("user_id") @db.Uuid
  /// UTC calendar day.
  periodStart  DateTime @map("period_start") @db.Date
  costMicroUsd BigInt   @default(0) @map("cost_micro_usd")
  inputTokens  BigInt   @default(0) @map("input_tokens")
  outputTokens BigInt   @default(0) @map("output_tokens")
  requests     Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, periodStart])
  @@map("usage_ledger")
  @@schema("platform")
}
