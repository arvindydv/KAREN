# apps/web — PUBLIC values (compiled into the browser bundle). Never put secrets here.
NEXT_PUBLIC_APP_ENV=local

# SERVER-ONLY values (BFF: route handlers, server components, src/proxy.ts). Never NEXT_PUBLIC_.
# Where the BFF reaches the KAREN API. The browser never calls the API directly.
API_INTERNAL_BASE_URL=http://localhost:4100
# local|test permit the non-__Host- cookie names over plain-http localhost/LAN dev; every other
# value forces __Host- + Secure cookies. Must be set explicitly in deployed images.
APP_ENV=local
# Exact browser-facing origin for the Origin/CSRF check. REQUIRED outside local/test.
# WEB_PUBLIC_ORIGIN=https://app.example.com
# Shared with the API; signs the forwarded end-user IP (x-karen-client-ip). >=32 chars.
# REQUIRED outside local/test. Must equal the API value. Never NEXT_PUBLIC_.
# INTERNAL_SERVICE_HMAC_SECRET=
# Number of trusted proxy hops in front of this app (ALB = 1).
# BFF_TRUSTED_PROXY_HOPS=1
