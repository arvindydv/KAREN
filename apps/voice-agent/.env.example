# KAREN voice agent — safe local defaults. Never commit real values.

# local | test | dev | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# --- LiveKit server credentials (worker side only) --------------------------------
# Optional to import/test; `karen-voice dev|start` refuses to run without all three.
# The worker never mints client tokens; the API mints short-lived user tokens.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker HTTP health server (503 until registered with LiveKit)
VOICE_AGENT_HEALTH_PORT=8200

# --- Audio capability gate (closed by default: NOT VERIFIED) ----------------------
KAREN_FEATURE_AUDIO_ENABLED=false
KAREN_MODEL_AUDIO=
KAREN_MODEL_REGISTRY_PATH=

# --- AI service text path ----------------------------------------------------------
AI_SERVICE_URL=http://localhost:8100
# Required (>=32 chars) in dev/staging/production.
INTERNAL_SERVICE_HMAC_SECRET=

# --- Observability (optional) -----------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=karen-voice-agent
SENTRY_DSN=
