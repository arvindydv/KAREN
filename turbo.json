{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "globalPassThroughEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "APP_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "TEMPORAL_ADDRESS"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "openapi:generate": {
      "dependsOn": ["^build"],
      "outputs": ["openapi/**", "src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
