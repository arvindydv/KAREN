{
  "name": "karen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev:core": "node scripts/dev-core.mjs",
    "dev:web": "turbo run dev --filter=@karen/web",
    "dev:admin": "turbo run dev --filter=@karen/admin",
    "dev:mobile": "turbo run build --filter=@karen/mobile^... && pnpm --filter @karen/mobile start",
    "dev:api": "turbo run dev --filter=@karen/api",
    "dev:ai": "uv run --directory apps/ai-service karen-ai-dev",
    "dev:temporal-worker": "turbo run dev --filter=@karen/temporal-worker",
    "dev:provider-worker": "turbo run dev --filter=@karen/provider-worker",
    "dev:voice": "uv run --directory apps/voice-agent karen-voice dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:validate": "node scripts/terraform-validate.mjs",
    "db:generate": "pnpm --filter @karen/api db:generate",
    "db:migrate": "pnpm --filter @karen/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @karen/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @karen/api db:migrate:status",
    "db:migrate:diff": "pnpm --filter @karen/api db:migrate:diff",
    "db:roles": "pnpm --filter @karen/api db:roles",
    "db:seed": "pnpm --filter @karen/api db:seed",
    "db:reset": "pnpm --filter @karen/api db:reset",
    "lint": "turbo run lint",
    "lint:py": "uv run --directory apps/ai-service ruff check . && uv run --directory apps/ai-service ruff format --check . && uv run --directory apps/voice-agent ruff check . && uv run --directory apps/voice-agent ruff format --check .",
    "typecheck": "turbo run typecheck",
    "typecheck:py": "uv run --directory apps/ai-service mypy && uv run --directory apps/voice-agent mypy",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1 && pnpm test:integration:py",
    "test:integration:py": "uv run --directory apps/ai-service pytest -m integration",
    "test:py": "uv run --directory apps/ai-service pytest && uv run --directory apps/voice-agent pytest",
    "test:e2e:web": "pnpm --filter @karen/web test:e2e",
    "contracts:generate": "pnpm --filter @karen/api openapi:generate",
    "contracts:check": "node scripts/check-openapi-drift.mjs",
    "evals": "uv run --directory apps/ai-service python -m karen_ai.evaluation.run_golden ../../evals/golden-cases",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env-public": "node scripts/check-public-env.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "verify": "pnpm format:check && pnpm check:env-public && pnpm check:migrations && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup:env": "node scripts/setup-env.mjs",
    "verify:py": "pnpm lint:py && pnpm typecheck:py && pnpm test:py"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
