# Copy to terraform.tfvars (git-ignored). Placeholder values only - NO secrets
# belong in this file. Secret values go into Secrets Manager out-of-band.

# Guard against applying to the wrong account.
allowed_account_ids = ["000000000000"]

# ACM certificate in ap-south-1 covering the hostnames below.
acm_certificate_arn = "arn:aws:acm:ap-south-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"

api_hostname = "api.staging.example.com"
# webhooks_hostname = "hooks.staging.example.com"

# Cloudflare IPv4 ranges - VERIFY against https://www.cloudflare.com/ips-v4
# before applying; they change occasionally.
alb_ingress_ipv4_cidrs = [
  "173.245.48.0/20",
  "103.21.244.0/22",
  "103.22.200.0/22",
  "103.31.4.0/22",
  "141.101.64.0/18",
  "108.162.192.0/18",
  "190.93.240.0/20",
  "188.114.96.0/20",
  "197.234.240.0/22",
  "198.41.128.0/17",
  "162.158.0.0/15",
  "104.16.0.0/13",
  "104.24.0.0/14",
  "172.64.0.0/13",
  "131.0.72.0/22",
]

# Immutable tags (git SHA) of images already pushed to the ECR repositories.
image_tags = {
  api               = "0000000"
  "ai-service"      = "0000000"
  "temporal-worker" = "0000000"
  "provider-worker" = "0000000"
  "voice-agent"     = "0000000"
}

livekit_url = "wss://REPLACE_ME.livekit.cloud"

alert_email_addresses = ["oncall@staging.example.com"]
# budget_monthly_limit_usd = 500

# Optional Next.js apps on ECS (deploy target undecided: Vercel vs ECS).
# enable_web   = true
# web_hostname = "app.staging.example.com"
# enable_admin        = true   # requires admin_allowed_cidrs; see docs/architecture/infrastructure.md
# admin_hostname      = "admin.staging.example.com"
# admin_allowed_cidrs = ["198.51.100.0/24"]

# First-party identity (ADR-0015/0016/0018). Key material goes in Secrets Manager, not here.
identity = {
  access_token_current_kid   = "k1"
  password_pepper_current_id = "p1"
  email_from                 = "KAREN <no-reply@example.com>" # Brevo-verified sender on an owned domain
}
